{
  "name": "mujina-prod-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "author": "Nagitch",
  "contributors": [
    "藍+85CD (Urara upstream author)"
  ],
  "license": "WTFPL",
  "homepage": "https://www.mujina-prod.com/",
  "repository": "github:Nagitch/mujina-prod-site",
  "bugs": "https://github.com/Nagitch/mujina-prod-site/issues",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node --version && run-s tsc urara:build kit:build clean",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "clean": "node urara.js clean",
    "dev": "run-s tsc \"dev:parallel {@} \" --",
    "dev:parallel": "run-p -r tsc:watch urara:watch \"kit:dev {@} \" --",
    "kit:build": "cross-env NODE_OPTIONS=--max_old_space_size=7680 vite build",
    "kit:dev": "cross-env NODE_OPTIONS=--max_old_space_size=7680 vite dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "start": "cross-env ADAPTER=node pnpm build && node build",
    "test": "pnpm tsc && node --test tests/*.test.mjs",
    "tsc": "tsc -p tsconfig.node.json",
    "tsc:watch": "tsc -w -p tsconfig.node.json",
    "urara:build": "node urara.js build",
    "urara:watch": "node urara.js watch",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:install-policy": "node scripts/verify-install-policy.mjs"
  },
  "dependencies": {
    "@vfx-js/core": "^1.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/heroicons-solid": "^1.2.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/unist": "^3.0.3",
    "@unocss/eslint-plugin": "^66.12.0",
    "@unocss/extractor-svelte": "^66.12.0",
    "@xmldom/xmldom": "0.9.12",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fff-flavored-frontmatter": "^1.2.1",
    "github-slugger": "^2.0.0",
    "jiti": "^2",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.12.8",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-fff": "^1.2.1",
    "remark-footnotes": "~2.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "unocss": "^66.12.0",
    "vite": "^8.0.12",
    "vite-imagetools": "^9.0.3",
    "workbox-build": "^7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-window": "^7.4.1"
  }
}
