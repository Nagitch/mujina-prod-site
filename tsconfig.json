{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": [
      "$app/types",
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts/pwa-manifest.ts",
    "scripts/pwa-adapter.ts"
  ],
  "exclude": [
    "src/sw.ts",
    "node_modules",
    "build",
    ".vercel"
  ]
}
